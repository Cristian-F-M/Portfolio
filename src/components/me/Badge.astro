---
import { twMerge } from "tailwind-merge";

interface Props {
	text: string;
	class?: string;
}

const { text, class: className } = Astro.props;
---

<span
	class={twMerge(
		"px-3.5 py-1.5 bg-neutral/60 inset-shadow-[0_0_4px_var(--text-primary)] inset-shadow-gray-500/40 text-xs text-gray-400 rounded cursor-cell",
		className,
	)}
>
	{text}
</span>
