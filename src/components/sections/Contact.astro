---
import Section from "@/components/sections/Section.astro";
import Input from "@/components/form/Input.astro";
import {
	IconArrowUpRight,
	IconBrandGithub,
	IconBrandLinkedin,
	IconBrandTelegram,
	IconBrandX,
	IconMail,
	IconMapPin,
} from "@tabler/icons-react";
---

<Section id="contact">
	<header class="text-7xl">
		<h2 class="text-text-primary font-bold">
			<span>LET'S BUILD</span>
			<br />
			<span class="gradient-text">SOMETHING GREAT</span>
		</h2>

		<p class="text-base w-120 mt-8 pl-6 border-l border-primary">
			Available for innovative collaborations and technical challenges. Drop a
			message to start the architectural process.
		</p>
	</header>

	<main class="flex flex-row items-center gap-10 mt-10">
		<div
			class="w-full bg-surface p-8 border border-primary/20 rounded-lg relative self-start"
		>
			<div class="absolute top-1 right-1">
				<IconMail width={70} height={70} className="text-text-muted" />
			</div>
			<form class="space-y-10" id="contact-form">
				<div class="flex flex-row items-center justify-between gap-6">
					<Input id="name" name="name" label="Name" placeholder="John Doe" />
					<Input
						id="email"
						name="email"
						label="Email"
						placeholder="john@gmail.com"
					/>
				</div>
				<!-- <Input label="Message" /> -->
				<label class="flex flex-col gap-1 w-full">
					<span
						class="text-xs text-text-muted has-[+textarea:focus]:text-text-primary transition-colors"
					>
						MESSAGE
					</span>
					<textarea
						name="message"
						id="message"
						placeholder="Describe the project parameters..."
						class="border-b-2 border-border focus:border-primary outline-none caret-primary text-text-secondary text-sm transition-colors resize-none field-sizing-content min-h-24 max-h-36 placeholder:text-xs placeholder:text-text-muted"
					></textarea>
					<span class="error text-sm text-red-600"></span>
				</label>

				<div>
					<button
						class="button-glow bg-primary px-4 py-2 rounded font-jet-brains text-sm flex flex-row items-cente gap-2"
					>
						INITIATE_CONTACT
						<IconBrandTelegram
							width={20}
							height={20}
							className="text-gray-800"
						/>
					</button>
				</div>
			</form>
		</div>

		<aside class="w-full">
			<h3 class="text-text-primary font-jet-brains tracking-widest">
				VIRTUAL_PRESENCE
			</h3>

			<div class="space-y-4 mt-4">
				<a
					href="https://github.com/Cristian-F-M/"
					class="network-link"
					target="_blank"
				>
					<IconBrandGithub width={28} height={28} />
					<header>
						<h6>GITHUB</h6>
						<span>/Cristian-F-M</span>
					</header>
					<div class="external-link">
						<IconArrowUpRight width={28} height={28} />
					</div>
				</a>
				<a
					href="https://linkedin.com/in/cmoralesdev/"
					class="network-link"
					target="_blank"
				>
					<IconBrandLinkedin width={28} height={28} />
					<header>
						<h6>LINKEDIN</h6>
						<span>/cmoralesdev</span>
					</header>
					<div class="external-link">
						<IconArrowUpRight width={28} height={28} />
					</div>
				</a>
				<a
					href="https://x.com/Morales_M20"
					class="network-link"
					target="_blank"
				>
					<IconBrandX />
					<header>
						<h6>TWITTER</h6>
						<span>@Morales_M20</span>
					</header>
					<div class="external-link">
						<IconArrowUpRight />
					</div>
				</a>
			</div>

			<a
				href="https://maps.app.goo.gl/MhNHSXA28ABCf5zx7"
				class="block mt-5 p-6 border-2 border-border rounded bg-surface"
				target="_blank"
			>
				<header class="flex flex-row items-center gap-2">
					<IconMapPin
						width={28}
						height={28}
						className="text-primary self-start"
					/>
					<div class="flex flex-col text-text-primary">
						<h5 class="font-jet-brains tracking-widest">COORDINATES</h5>
						<span class="text-gray-400 text-xs">Remote / CMORALES</span>
						<span class="text-gray-400 text-xs"
							>Base: Bucaramanga, Colombia 🇨🇴</span
						>
					</div>
				</header>
				<div class="w-full h-32 aspect-video overflow-hidden rounded mt-6">
					<img class="size-full object-cover" src="/images/mapa.avif" alt="" />
				</div>
			</a>
		</aside>
	</main>
</Section>

<style>
	@reference "../../styles/global.css";

	.network-link {
		@apply bg-surface p-6 flex flex-row gap-4 rounded items-center transition-colors;
	}

	.network-link:hover {
		@apply bg-surface-soft;
	}

	.network-link > svg {
		@apply text-primary;
	}

	.network-link header {
		@apply font-jet-brains tracking-widest;
	}

	.network-link header h6 {
		@apply text-sm text-text-secondary;
	}

	.network-link header span {
		@apply text-xs text-text-muted;
	}

	.network-link .external-link {
		@apply ml-auto text-text-muted;
	}
</style>

<script>
	export interface Issue {
		expected: string;
		code: string;
		path: string[];
		message: string;
	}

	import Toastify from "toastify-js";
	import { actions } from "astro:actions";

	const $form = document.getElementById(
		"contact-form",
	) as HTMLFormElement | null;

	const toastifyCommonOptions = {
		style: {
			background: "var(--color-surface-soft)",
		},
		close: true,
		gravity: "top",
		position: "center",
		stopOnFocus: true,
		className: "rounded bg-surface-soft border border-border shadow-primary",
		duration: 3000,
	} satisfies Toastify.Options;

	const t = Toastify({
		...toastifyCommonOptions,
		duration: -1,
		text: "Sending...",
	});

	$form?.addEventListener("submit", async (event) => {
		event.preventDefault();

		t.showToast();
		const form = event.currentTarget as HTMLFormElement;
		const formData = new FormData(form);
		const { error, data } = await actions.contact.sendEmail(formData);

		t.hideToast();

		if (error) {
			const message = error.message.replace("Failed to validate: ", "");
			const issues = JSON.parse(message) as Issue[];

			issues.forEach(({ path, message }) => {
				let $input = document.getElementById(path[0]) as
					| HTMLInputElement
					| HTMLTextAreaElement
					| null;

				if (!$input) return;

				setInputError($input, message);
			});

			return;
		}

		if (data.succes) {
			Toastify({
				...toastifyCommonOptions,
				text: data.message,
			}).showToast();

			return;
		}

		const callback = () => {
			const name = formData.get("name");
			const email = formData.get("email");
			const message = formData.get("message");

			const subject = "I want to get your development services";
			const body = `${message}

					\r${name}
					\r${email}
			`;

			const url = `mailto:cfmorales.diaz@gmail.com?subject=${subject}&body=${body}`;

			window.open(url, "_blank");
		};

		Toastify({
			...toastifyCommonOptions,
			text: `${data.message}, click here to open.`,
			onClick: callback,
		}).showToast();
	});

	const elements = $form?.elements;

	Array.from(elements ?? []).forEach((e) => {
		if (!(e instanceof HTMLInputElement) && !(e instanceof HTMLTextAreaElement))
			return;

		e.addEventListener("input", () => {
			setInputError(e, "");
		});
	});

	function setInputError(
		input: HTMLInputElement | HTMLTextAreaElement,
		message: string,
	) {
		const $label = input.parentElement;
		const $error = $label?.querySelector(".error");

		if (!$error) return;

		$error.textContent = message;
	}
</script>
