---
import Section from "@/components/sections/Section.astro";
import Input from "@/components/form/Input.astro";
import {
	IconArrowUpRight,
	IconBrandGithub,
	IconBrandLinkedin,
	IconBrandTelegram,
	IconBrandX,
	IconMail,
	IconMapPin,
} from "@tabler/icons-react";
import { getLocaleUrl, translations, getValueByPath } from "@/i18n/utils";
import { languages } from "@/i18n/ui";
import { ui } from "@/i18n/ui";
import type { Path } from "@/types/i18n";

const { t, lang } = translations(Astro.url);
const link = (path: string) => getLocaleUrl(lang, path);

const toastMessagesEntries = Object.keys(languages).map((l) => {
	const t = (p: Path) => getValueByPath(ui[l as keyof typeof ui], p);
	const ts = {
		sending: t("index.lets_build.sending"),
		sent: t("index.lets_build.sending"),
		error: {
			name: {
				required: t("index.lets_build.form.name.error.required"),
				min: t("index.lets_build.form.name.error.min"),
			},
			email: { valid: t("index.lets_build.form.email.error.valid") },
			message: {
				required: t("index.lets_build.form.message.error.required"),
				min: t("index.lets_build.form.message.error.min"),
			},
		},
		click_here: t("index.lets_build.click_here"),
	};
	return [l, ts];
});

const toastMessages = Object.fromEntries(toastMessagesEntries);
---

<Section id="contact">
	<div id="toast-data" hidden class="opacity-0 size-0">
		{JSON.stringify(toastMessages)}
	</div>

	<header class="text-7xl">
		<h2
			class="text-text-primary font-bold uppercase"
			set:html={t("index.lets_build.title")}
		/>

		<p class="text-base w-120 mt-8 pl-6 border-l border-primary">
			{t("index.lets_build.description")}
		</p>
	</header>

	<main class="flex flex-row items-center gap-10 mt-10">
		<div
			class="w-full bg-surface p-8 border border-primary/20 rounded-lg relative self-start"
		>
			<div class="absolute top-1 right-1">
				<IconMail width={70} height={70} className="text-text-muted" />
			</div>
			<form class="space-y-10" id="contact-form">
				<div class="flex flex-row items-center justify-between gap-6">
					<Input
						id="name"
						name="name"
						label={t("index.lets_build.form.name.name")}
						placeholder={t("index.lets_build.form.name.placeholder")}
					/>
					<Input
						id="email"
						name="email"
						label={t("index.lets_build.form.email.name")}
						placeholder={t("index.lets_build.form.email.placeholder")}
					/>
				</div>
				<Input
					label={t("index.lets_build.form.message.name")}
					name="message"
					id="message"
					placeholder={t("index.lets_build.form.message.placeholder")}
					textArea
				/>
				<div>
					<button
						type="submit"
						class="button-glow bg-primary px-4 py-2 rounded font-jet-brains text-sm flex flex-row items-cente gap-2"
					>
						{t("index.lets_build.form.initiate_contact")}
						<IconBrandTelegram
							width={20}
							height={20}
							className="text-gray-800"
						/>
					</button>
				</div>
			</form>
		</div>

		<aside class="w-full">
			<h3 class="text-text-primary font-jet-brains tracking-widest uppercase">
				{t("index.lets_build.virtual_presence.title")}
			</h3>

			<div class="space-y-4 mt-4">
				<a
					href="https://github.com/Cristian-F-M/"
					class="network-link"
					target="_blank"
				>
					<IconBrandGithub width={28} height={28} />
					<header>
						<h6>GITHUB</h6>
						<span>/Cristian-F-M</span>
					</header>
					<div class="external-link">
						<IconArrowUpRight width={28} height={28} />
					</div>
				</a>
				<a
					href="https://linkedin.com/in/cmoralesdev/"
					class="network-link"
					target="_blank"
				>
					<IconBrandLinkedin width={28} height={28} />
					<header>
						<h6>LINKEDIN</h6>
						<span>/cmoralesdev</span>
					</header>
					<div class="external-link">
						<IconArrowUpRight width={28} height={28} />
					</div>
				</a>
				<a
					href="https://x.com/Morales_M20"
					class="network-link"
					target="_blank"
				>
					<IconBrandX />
					<header>
						<h6>TWITTER</h6>
						<span>@Morales_M20</span>
					</header>
					<div class="external-link">
						<IconArrowUpRight />
					</div>
				</a>
			</div>

			<a
				href="https://maps.app.goo.gl/MhNHSXA28ABCf5zx7"
				class="block mt-5 p-6 border-2 border-border rounded bg-surface"
				target="_blank"
			>
				<header class="flex flex-row items-center gap-2">
					<IconMapPin
						width={28}
						height={28}
						className="text-primary self-start"
					/>
					<div class="flex flex-col text-text-primary">
						<h5 class="font-jet-brains tracking-widest uppercase">
							{t("index.lets_build.virtual_presence.coordinates")}
						</h5>
						<span class="text-gray-400 text-xs">Remote / CMORALES</span>
						<span class="text-gray-400 text-xs"
							>Base: Bucaramanga, Colombia 🇨🇴</span
						>
					</div>
				</header>
				<div class="w-full h-32 aspect-video overflow-hidden rounded mt-6">
					<img class="size-full object-cover" src="/images/mapa.avif" alt="" />
				</div>
			</a>
		</aside>
	</main>
</Section>

<style>
	@reference "../../styles/global.css";

	.network-link {
		@apply bg-surface p-6 flex flex-row gap-4 rounded items-center transition-colors;
	}

	.network-link:hover {
		@apply bg-surface-soft;
	}

	.network-link > svg {
		@apply text-primary;
	}

	.network-link header {
		@apply font-jet-brains tracking-widest;
	}

	.network-link header h6 {
		@apply text-sm text-text-secondary;
	}

	.network-link header span {
		@apply text-xs text-text-muted;
	}

	.network-link .external-link {
		@apply ml-auto text-text-muted;
	}
</style>

<script>
	export interface Issue {
		expected: string;
		code: string;
		path: string[];
		message: string;
	}

	import Toastify from "toastify-js";
	import { actions } from "astro:actions";
	import type { Lang, Path, PathToString } from "@/types/i18n";
	const pathname = document.location.pathname;
	const [_, lang] = pathname.split("/");

	const defaultToastMessages = {
		en: {
			sending: "Sending email...",
			sent: "Sent email successfull...",
			error: {
				name: {
					required: 'Filed "name" is required',
					min: 'Filed "name" must have at least 2 characters',
				},
				email: {
					valid: 'Filed "email" must be a valid email',
					message: {
						required: 'Filed "message" is required',
						min: 'Filed "message" must have at least 10 characters',
					},
				},
			},
			click_here: "Click here to open.",
		},
	};

	const $toastData = document.getElementById("toast-data");

	let toastMessages = defaultToastMessages;

	try {
		toastMessages = JSON.parse($toastData?.textContent ?? "");
	} catch {}

	const translation = (lang: string) => {
		if (lang in toastMessages) {
			return toastMessages[lang as keyof typeof toastMessages];
		}
		return toastMessages["en"];
	};
	const tM = translation(lang);

	const $form = document.getElementById(
		"contact-form",
	) as HTMLFormElement | null;

	const toastifyCommonOptions = {
		style: {
			background: "var(--color-surface-soft)",
		},
		close: true,
		gravity: "top",
		position: "center",
		stopOnFocus: true,
		className: "rounded bg-surface-soft border border-border shadow-primary",
		duration: 3000,
	} satisfies Toastify.Options;

	const t = Toastify({
		...toastifyCommonOptions,
		duration: -1,
		text: tM.sending,
	});

	$form?.addEventListener("submit", async (event) => {
		event.preventDefault();

		t.showToast();
		const form = event.currentTarget as HTMLFormElement;
		const formData = new FormData(form);
		const { error, data } = await actions.contact.sendEmail(formData);

		t.hideToast();

		if (error) {
			const message = error.message.replace("Failed to validate: ", "");
			const issues = JSON.parse(message) as Issue[];

			issues.forEach(({ path, message }) => {
				let $input = document.getElementById(path[0]) as
					| HTMLInputElement
					| HTMLTextAreaElement
					| null;

				if (!$input) return;

				setInputError($input, message as ToastMessagePath);
			});

			return;
		}

		if (data.success) {
			Toastify({
				...toastifyCommonOptions,
				text: data.message,
			}).showToast();

			return;
		}

		const callback = () => {
			const name = formData.get("name");
			const email = formData.get("email");
			const message = formData.get("message");

			const subject = "I want to get your development services";
			const body = `${message}

					\r${name}
					\r${email}
			`;

			const url = `mailto:cfmorales.diaz@gmail.com?subject=${subject}&body=${body}`;

			window.open(url, "_blank");
		};

		Toastify({
			...toastifyCommonOptions,
			text: `${data.message}, ${tM.click_here}`,
			onClick: callback,
		}).showToast();
	});

	const elements = $form?.elements;

	Array.from(elements ?? []).forEach((e) => {
		if (!(e instanceof HTMLInputElement) && !(e instanceof HTMLTextAreaElement))
			return;

		e.addEventListener("input", () => {
			setInputError(e, "");
		});
	});

	type ToastMessages = typeof toastMessages;
	type ToastMessagePath = PathToString<ToastMessages["en"]>;

	function setInputError(
		input: HTMLInputElement | HTMLTextAreaElement,
		message: ToastMessagePath | "",
	) {
		const getValue = (
			obj: ToastMessages[keyof ToastMessages],
			path: ToastMessagePath,
		) => {
			const split = path.split(".") as any[];
			return split.reduce((acc, key) => acc?.[key], obj) as Lang | string;
		};

		const $label = input.parentElement;
		const $error = $label?.querySelector(".error");

		if (!$error) return;

		if (!message) return ($error.textContent = "");

		const error = getValue(tM, message);

		$error.textContent = typeof error === "string" ? error : "";
	}
</script>
