---
import Section from "@/components/sections/Section.astro";
import Badge from "@/components/layout/Badge.astro";
import Logo from "@/assets/cm.svg";
import {
	IconBrandPowershell,
	IconCloud,
	IconDatabase,
	IconDeviceMobile,
	IconShieldCheckeredFilled,
	IconStack,
} from "@tabler/icons-react";
import BentoBadge from "@/components/me/Badge.astro";
---

<Section id="me" class="mb-24">
	<section class="flex flex-row items-center justify-between gap-28">
		<article class="space-y-6">
			<Badge class="uppercase text-primary text-xs bg-neutral/60">
				<span
					class="flex items-center justify-center size-3 bg-primary rounded-full relative"
				>
					<span
						class="block absolute size-5 bg-primary rounded-full -z-1 animate-ping"
					></span>
				</span>
				OPERATIONAL_STATUS: ACTIVE
			</Badge>

			<h2 class="uppercase font-bold text-6xl mt-2">
				<span class="text-white">WHO I</span>
				<span class="gradient-text">AM</span>
			</h2>

			<p class="text-gray-400 text-sm mt-1 w-150">
				I architect digital ecosystems where performance meets precision. My
				approach transcends simple coding—I solve complex structural challenges
				with engineered solutions.
			</p>

			<div class="flex flex-row gap-2 items-center mt-5">
				<div class="card border-primary">
					<h4>Philosophy</h4>
					<p>
						Code is a liability; systems are the asset. I build for longevity
						and scalability.
					</p>
				</div>
				<div class="card border-secondary">
					<h4>Focus</h4>
					<p>
						Obsessive optimization of critical paths and high-availability
						architecture.
					</p>
				</div>
			</div>
		</article>
		<article>
			<div class="size-84 shadow-2xl shadow-primary/40 p-5">
				<Logo class="size-full text-white" />
			</div>
		</article>
	</section>

	<section class="mt-20">
		<header class="flex flex-row items-center justify-between">
			<div>
				<h2 class="text-white">TECHNICAL_STACK</h2>
				<p class="text-gray-400 text-sm">
					Leveraging modern primitives to build resilient, distributed systems.
				</p>
			</div>

			<div
				class="font-space-grotesk text-gray-500 border-l border-primary pl-3 text-xs"
			>
				V_04 // DEPLOYED
			</div>
		</header>

		<main class="grid grid-cols-12 grid-rows-4 gap-4 mt-4">
			<div class="bento-card col-span-8 row-span-2">
				<header>
					<div>
						<IconStack width={25} height={25} />
					</div>
					<h3>FRONTEND_LAYER</h3>
				</header>
				<main>
					{
						["REACT", "NEXT.JS", "TYPESCRIPT", "TAILWIND_CSS", "THREE.JS"].map(
							(t) => <BentoBadge text={t} />,
						)
					}
				</main>
			</div>
			<div class="bento-card col-span-4 row-span-2 col-start-9">
				<header>
					<div>
						<IconDatabase width={25} height={25} />
					</div>
					<h3>CORE_ENGIE</h3>
				</header>
				<main>
					{
						["REACT", "NEXT.JS", "TYPESCRIPT", "TAILWIND_CSS", "THREE.JS"].map(
							(t) => <BentoBadge text={t} />,
						)
					}
				</main>
			</div>
			<div class="bento-card col-span-4 row-span-2 row-start-3">
				<header>
					<div>
						<IconDeviceMobile width={25} height={25} />
					</div>
					<h3>MOBILE</h3>
				</header>
				<main>
					{["REACT_NATIVE ", "EXPO"].map((t) => <BentoBadge text={t} />)}
				</main>
			</div>
			<div class="bento-card col-span-8 row-span-2 col-start-5 row-start-3">
				<header>
					<div>
						<IconBrandPowershell width={25} height={25} />
					</div>
					<h3>INFRASTRUCTURE</h3>
				</header>
				<main class="justify-between">
					<div class="flex flex-row gap-2 flex-wrap items-center">
						<p class="text-sm text-gray-400">
							Automated pipelines and cloud-native deployments for zero-downtime
							releases.
						</p>
					</div>
					<div
						class="flex flex-row gap-2 items-center [&_div]:p-2 [&_div]:bg-neutral [&_div]:rounded [&_div]:border [&_div]:border-tertiary/20"
					>
						<div>
							<IconCloud width={24} height={24} className="text-primary/70" />
						</div>
						<div>
							<IconShieldCheckeredFilled
								width={24}
								height={24}
								className="text-primary/70"
							/>
						</div>
						<div>
							<IconBrandPowershell
								width={24}
								height={24}
								className="text-primary/70"
							/>
						</div>
					</div>
				</main>
			</div>
		</main>
	</section>

	<section class="mt-24">
		<header class="flex flex-col items-center justify-center">
			<h2 class="text-white text-6xl font-bold text-center">
				<span>HOW I</span>
				<span class="gradient-text">BUILD</span>
			</h2>
			<span class="block h-1 w-24 bg-primary rounded-[100%] mt-2 neon-line"
			></span>
		</header>

		<main class="flex flex-row items-center gap-4 m-10">
			<div class="build-card">
				<span>01</span>
				<header>PLANNING</header>
				<main>Discovery, user journey mapping, and requirement scoping.</main>
			</div>
			<div class="build-card">
				<span>02</span>
				<header>ARCHITECTURE</header>
				<main>System design, data modeling, and schema definition.</main>
			</div>
			<div class="build-card">
				<span>03</span>
				<header>DEVELOPMENT</header>
				<main>Test-driven implementation with clean, documented code.</main>
			</div>
			<div class="build-card">
				<span>04</span>
				<header>OPTIMIZATION</header>
				<main>Performance tuning, stress testing, and deployment.</main>
			</div>
		</main>
	</section>
</Section>

<style>
	@reference "../../styles/global.css";
	.card {
		@apply bg-neutral rounded-md p-4 border;

		h4 {
			@apply uppercase text-primary;
		}

		p {
			@apply text-xs text-gray-400 w-10/12 mt-px;
		}
	}

	.card:nth-child(2) h4 {
		@apply text-secondary;
	}
</style>

<style>
	@reference "../../styles/global.css";

	.bento-card {
		@apply bg-tertiary/5 p-6 shadow shadow-tertiary/30;
	}

	.bento-card header {
		@apply flex flex-row items-center gap-1 text-white;
	}

	.bento-card main {
		@apply flex flex-row items-center gap-2 flex-wrap mt-2;
	}
</style>

<style>
	.neon-line {
		box-shadow:
			0 0 5px var(--color-primary),
			0 0 10px var(--color-primary),
			0 0 20px var(--color-primary),
			0 0 40px #0095ff;
	}
</style>

<style>
	@reference "../../styles/global.css";

	.build-card {
		@apply bg-neutral w-full px-6 py-8 pb-6 rounded-lg relative border border-primary/20;
	}

	.build-card span {
		@apply absolute -top-4 left-1/2 -translate-x-1/2 flex bg-tertiary/5 border border-primary/20 rounded-full size-8 items-center justify-center text-[10px] text-white backdrop-blur-2xl;
	}

	.build-card header {
		@apply text-center text-lg text-white font-jet-brains uppercase;
	}

	.build-card main {
		@apply text-center text-gray-400 text-xs mt-1;
	}
</style>
