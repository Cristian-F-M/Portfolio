---
import Section from "@/components/sections/Section.astro";
import Badge from "@/components/layout/Badge.astro";
import Logo from "@/assets/cm.svg";
import {
	IconBrandPowershell,
	IconCloud,
	IconDatabase,
	IconDeviceMobile,
	IconShieldCheckeredFilled,
	IconStack,
} from "@tabler/icons-react";
import BentoBadge from "@/components/me/Badge.astro";
import { getLocaleUrl, translations } from "@/i18n/utils";
import { ui } from "@/i18n/ui";

const { t, lang } = translations(Astro.url);
const link = (path: string) => getLocaleUrl(lang, path);
const l = ui[lang];
---

<Section id="me" class="mb-24">
	<section class="flex flex-row items-center justify-between gap-28">
		<article class="space-y-6">
			<Badge class="uppercase text-primary text-xs">
				<span
					class="flex items-center justify-center size-3 bg-primary rounded-full relative"
				>
					<span
						class="block absolute size-5 bg-primary rounded-full animate-ping"
					></span>
				</span>
				{t("index.me.operational_status")}: <strong>{t("status.active")}</strong
				>
			</Badge>

			<h2
				class="uppercase font-bold text-6xl mt-2"
				set:html={t("index.me.title")}
			/>

			<p class="text-gray-400 text-sm mt-1 w-150">
				{t("index.me.description")}
			</p>

			<div class="flex flex-row gap-2 items-center mt-5">
				{
					Object.values(l.index.me.cards).map((c) => {
						return (
							<div class="card">
								<h4>{c.title}</h4>
								<p>{c.description}</p>
							</div>
						);
					})
				}
			</div>
		</article>
		<article>
			<div class="size-84 drop-shadow-2xl drop-shadow-primary/40 p-5">
				<Logo class="size-full text-text-primary" />
			</div>
		</article>
	</section>

	<section class="mt-20">
		<header class="flex flex-row items-center justify-between">
			<div>
				<h2 class="text-text-primary uppercase text-4xl font-bold">
					{t("index.me.technical_stack.title")}
				</h2>
				<p class="text-sm">
					{t("index.me.technical_stack.description")}
				</p>
			</div>

			<div
				class="font-space-grotesk text-text-muted border-l border-primary pl-3 text-xs"
			>
				V_04 // DEPLOYED
			</div>
		</header>

		<main class="grid grid-cols-12 grid-rows-4 gap-4 mt-4">
			<div class="bento-card col-span-8 row-span-2">
				<header>
					<div>
						<IconStack width={25} height={25} />
					</div>
					<h3>{t("index.me.technical_stack.frontend_layer")}</h3>
				</header>
				<main>
					{
						["REACT", "NEXT.JS", "TYPESCRIPT", "TAILWIND_CSS", "THREE.JS"].map(
							(t) => <BentoBadge text={t} />,
						)
					}
				</main>
			</div>
			<div class="bento-card col-span-4 row-span-2 col-start-9">
				<header>
					<div>
						<IconDatabase width={25} height={25} />
					</div>
					<h3>{t("index.me.technical_stack.core_engine")}</h3>
				</header>
				<main>
					{
						["REACT", "NEXT.JS", "TYPESCRIPT", "TAILWIND_CSS", "THREE.JS"].map(
							(t) => <BentoBadge text={t} />,
						)
					}
				</main>
			</div>
			<div class="bento-card col-span-4 row-span-2 row-start-3">
				<header>
					<div>
						<IconDeviceMobile width={25} height={25} />
					</div>
					<h3>{t("index.me.technical_stack.mobile")}</h3>
				</header>
				<main>
					{["REACT_NATIVE ", "EXPO"].map((t) => <BentoBadge text={t} />)}
				</main>
			</div>
			<div class="bento-card col-span-8 row-span-2 col-start-5 row-start-3">
				<header>
					<div>
						<IconBrandPowershell width={25} height={25} />
					</div>
					<h3>{t("index.me.technical_stack.infrastructure.title")}</h3>
				</header>
				<main class="flex flex-row justify-between">
					<div class="flex flex-row gap-2 flex-wrap items-center w-8/12">
						<p class="text-sm text-gray-400">
							{t("index.me.technical_stack.infrastructure.description")}
						</p>
					</div>
					<div
						class="flex flex-row gap-2 items-center [&_div]:p-2 [&_div]:bg-surface-soft [&_div]:rounded [&_div]:border [&_div]:border-border"
					>
						<div>
							<IconCloud width={24} height={24} className="text-primary" />
						</div>
						<div>
							<IconShieldCheckeredFilled
								width={24}
								height={24}
								className="text-primary"
							/>
						</div>
						<div>
							<IconBrandPowershell
								width={24}
								height={24}
								className="text-primary"
							/>
						</div>
					</div>
				</main>
			</div>
		</main>
	</section>

	<section class="mt-24">
		<header class="flex flex-col items-center justify-center">
			<h2
				class="text-text-primary text-6xl font-bold text-center uppercase"
				set:html={t("index.me.how_i_build.title")}
			/>
			<span class="block h-1 w-24 bg-primary rounded-[100%] mt-2 neon-line"
			></span>
		</header>

		<main class="flex flex-row items-center gap-4 m-10">
			{
				Object.values(l.index.me.how_i_build.cards).map((c, i) => {
					return (
						<div class="build-card">
							<span>{String(i + 1).padStart(2, "0")}</span>
							<header>{c.title}</header>
							<main>
								<p>{c.description}</p>
							</main>
						</div>
					);
				})
			}
		</main>
	</section>
</Section>

<style>
	@reference "../../styles/global.css";
	.card {
		@apply bg-surface rounded-md p-4 border border-border;

		h4 {
			@apply uppercase text-text-primary;
		}

		p {
			@apply text-xs w-10/12 mt-px;
		}
	}
</style>

<style>
	@reference "../../styles/global.css";

	.bento-card {
		@apply bg-surface p-6 border border-border;
	}

	.bento-card header {
		@apply flex flex-row items-center gap-1 text-text-primary uppercase;
	}

	.bento-card main {
		@apply flex flex-row items-center gap-2 flex-wrap mt-2;
	}
</style>

<style>
	.neon-line {
		box-shadow:
			0 0 5px var(--color-primary),
			0 0 10px var(--color-primary),
			0 0 20px var(--color-primary),
			0 0 40px #0095ff;
	}
</style>

<style>
	@reference "../../styles/global.css";

	.build-card {
		@apply bg-surface-soft w-full px-6 py-8 pb-6 rounded-lg relative border border-primary/20;
	}

	.build-card span {
		@apply absolute -top-4 left-1/2 -translate-x-1/2 flex bg-surface border border-primary/20 rounded-full size-8 items-center justify-center text-[10px] text-text-primary backdrop-blur-2xl;
	}

	.build-card header {
		@apply text-center text-lg text-text-primary font-jet-brains uppercase;
	}

	.build-card main {
		@apply text-center text-text-secondary text-xs mt-1;
	}
</style>
