---
import Section from "@/components/sections/Section.astro";
---

<Section id="projects" class="mt-20">
	<div class="flex flex-row gap-2 items-center mb-5">
		<span class="block h-0.5 bg-primary w-16"></span>
		<h5 class="uppercase text-xs font-jet-brains text-primary tracking-widest">
			Deployment logs
		</h5>
	</div>

	<h2 class="uppercase font-bold text-6xl">
		<span class="text-white">Featured</span>
		<span class="gradient-text">Projects</span>
	</h2>

	<p class="text-gray-400 w-150 text-sm">
		Exploring the intersection of high-performance architecture and immersive
		visual interfaces. Each artifact is a study in digital structural integrity.
	</p>
</Section>
