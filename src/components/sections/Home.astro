---
import Logo from "@/src/assets/cm.svg";
import Section from "@/components/sections/Section.astro";
import Badge from "@/components/layout/Badge.astro";
import { IconBrain, IconChevronCompactDown } from "@tabler/icons-react";
import { translations } from "@/i18n/utils";
import { getLocaleUrl } from "@/i18n/utils";

const { t, lang } = translations(Astro.url);
const link = (path: string) => getLocaleUrl(lang, path);
---

<Section id="home" class="flex flex-row justify-between items-center mt-10">
	<section class="flex flex-col gap-8">
		<Badge class="uppercase text-primary text-xs">
			<span
				class="flex items-center justify-center size-3 bg-primary rounded-full relative"
			>
				<span
					class="block absolute size-5 bg-text-muted rounded-full animate-ping"
				></span>
			</span>
			{t("index.home.available_for_hire")}
		</Badge>
		<div>
			<h1 class="text-8xl font-space-grotesk text-text-primary font-bold">
				<span>Cristian</span>
				<br />
				<span class="gradient-text">Morales</span>
			</h1>

			<p class="w-2/3">
				{t("index.home.description")}
			</p>

			<div class="mt-5 flex flex-row gap-5">
				<a
					href={link("#projects")}
					class="button-glow bg-primary px-4 py-2 rounded font-jet-brains"
					>{t("index.home.view_projects")}</a
				>
				<a
					href={link("#contact")}
					class="block px-4 py-2 rounded font-jet-brains bg-surface hover:bg-surface-soft text-text-primary"
					>{t("index.home.contact_me")}</a
				>
			</div>
		</div>

		<div class="achievements flex flex-row justify-between w-7/12">
			<div>
				<span class="gradient-text font-jet-brains font-bold text-lg">+7</span>
				<span class="achievement-text"
					>{t("index.home.achievements.years_experience")}</span
				>
			</div>
			<div>
				<span class="gradient-text font-jet-brains font-bold text-lg">42+</span>
				<span class="achievement-text"
					>{t("index.home.achievements.projects_done")}</span
				>
			</div>
			<div>
				<span class="gradient-text font-jet-brains font-bold text-lg">12</span>
				<span class="achievement-text"
					>{t("index.home.achievements.technologies_learned")}</span
				>
			</div>
		</div>
	</section>
	<section class="relative">
		<Badge
			class="absolute top-0 right-0 bg-surface p-2 animate-float animate-iteration-count-infinite animate-duration-3500 animate-delay-900 border-border"
		>
			<Logo width={16} height={16} class="text-primary" />
		</Badge>
		<div class="w-96 rounded-full">
			<div class="border border-border rounded-full size-full p-3">
				<div class="border border-border rounded-full size-full p-8">
					<img
						src="/images/me.avif"
						alt={t("index.home.me_alt")}
						class="rounded-full animate-float animate-iteration-count-infinite animate-duration-3500"
					/>
				</div>
			</div>
		</div>
		<Badge
			class="absolute bottom-0 left-0 bg-surface-soft p-2 animate-float animate-iteration-count-infinite animate-duration-3500 animate-delay-1200 border-border"
		>
			<IconBrain width={16} height={16} className="text-text-muted" />
		</Badge>
	</section>

	<div
		class="absolute bottom-0 left-1/2 -translate-x-1/2 animate-hang animate-duration-2500 animate-iteration-count-infinite"
	>
		<IconChevronCompactDown width={30} height={30} className="text-primary" />
	</div>
</Section>

<style>
	@reference "../../styles/global.css";

	.achievements {
		@apply leading-none;

		& div {
			@apply flex flex-col gap-0;
		}

		& .achievement-text {
			@apply text-xs text-gray-300;
		}
	}
</style>
