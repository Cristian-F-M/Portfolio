---
import { twMerge } from "tailwind-merge";
import type { HTMLAttributes } from "astro/types";

interface BaseProps {
	label: string;
	class?: string;
	placeholder?: string;
	name: string;
	id: string;
	textArea?: boolean;
	labelProps?: HTMLAttributes<"label">;
}

interface InputProps extends HTMLAttributes<"input"> {
	textarea?: false;
}
interface TextAreaProps extends HTMLAttributes<"textarea"> {
	textarea: true;
}

type Props = BaseProps & (InputProps | TextAreaProps);

const {
	label,
	class: className,
	placeholder,
	name,
	id,
	textArea,
	labelProps,
	...props
} = Astro.props;
---

<label class={twMerge("flex flex-col gap-1 w-full", className)}>
	<span
		class="text-xs text-text-muted has-[+input:focus]:text-text-primary transition-colors uppercase"
		{...labelProps}>{label}</span
	>
	{
		textArea && (
			<textarea
				name={name}
				id={id}
				placeholder={placeholder}
				class="border-b-2 border-border focus:border-primary outline-none caret-primary text-text-secondary text-sm transition-colors resize-none field-sizing-content min-h-24 max-h-36 placeholder:text-xs placeholder:text-text-muted"
				{...props}
			/>
		)
	}

	{
		!textArea && (
			<input
				class="border-b-2 border-border focus:border-primary outline-none caret-primary text-text-secondary text-sm h-8 transition-colors placeholder:text-xs placeholder:text-text-muted"
				name={name}
				id={id}
				placeholder={placeholder}
				{...props}
			/>
		)
	}

	<span class="error text-sm text-red-600"></span>
</label>
