---
import { twMerge } from "tailwind-merge";

interface Props {
	label: string;
	class?: string;
	placeholder?: string;
}

const { label, class: className, placeholder } = Astro.props;
---

<label class={twMerge("flex flex-col gap-1 w-full", className)}>
	<span
		class="text-xs text-text-muted has-[+input:focus]:text-text-primary transition-colors uppercase"
		>{label}</span
	>

	<input
		class="border-b-2 border-border focus:border-primary outline-none caret-primary text-text-secondary text-sm h-8 transition-colors placeholder:text-xs placeholder:text-text-muted"
		type="text"
		placeholder={placeholder}
	/>
</label>
