---
import Logo from "@/assets/cm.svg";
import { getLocaleUrl, translations } from "@/i18n/utils";
import { twMerge } from "tailwind-merge";

interface Props {
	class?: string;
}

const { t, lang } = translations(Astro.url);
const link = (path: string) => getLocaleUrl(lang, path);

const { class: className } = Astro.props;
---

<footer
	class={twMerge(
		"flex flex-row justify-between items-center mt-10 px-6 py-8 bg-tertiary/5 w-full absolute left-0 backdrop-blur-2xl border-t border-border",
		className,
	)}
>
	<Logo width={40} height={40} class="text-white" />

	<p class="text-xs text-gray-400 font-jet-brains tracking-widest uppercase">
		<span>&copy;{new Date().getFullYear()}</span>
		<span>CMORALES</span>
		<span class="tracking-tighter">//</span>
		<span>{t("index.footer.architected_by")}</span>
	</p>

	<div
		class="flex flex-row items-center gap-6 text-gray-400 uppercase text-xs font-jet-brains tracking-widest [&_a]:hover:underline"
	>
		<a href="https://github.com/Cristian-F-M/">GitHub</a>
		<a href="https://linkedin.com/in/cmoralesdev/">Linkedin</a>
		<a href="https://x.com/Morales_M20">Twitter</a>
	</div>
</footer>
