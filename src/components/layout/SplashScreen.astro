---

---

<div
	id="splash-screen-overlay"
	class="fixed z-500 bg-[#111827] inset-0 size-full flex items-center justify-center transition-all transition-discrete starting:opacity-0 [.hide]:opacity-0 [.hide]:duration-700 duration-300"
>
	<div id="svg-container" class="svg-container">
		<svg
			width="200"
			height="200"
			viewBox="0 0 344 308"
			fill="none"
			xmlns="http://www.w3.org/2000/svg"
			class="text-white"
		>
			<path
				d="M344 32V254V255.5L302.5 223V117.5L238 168.5V240.5L198 208.5V150L344 32Z"
				fill="currentColor"></path>
			<path
				d="M175 166.5L103 110V161L174.5 217.127L175 166.5Z"
				fill="currentColor"></path>
			<path d="M69.5 308L0 253V203L102 282.5L69.5 308Z" fill="currentColor"
			></path>
			<path
				d="M94.5 52.5L0 127.5V75L94 0L175 63.8518V115L94.5 52.5Z"
				fill="currentColor"></path>
		</svg>
	</div>
</div>

<style>
	@reference "../../styles/global.css";

	.svg-container svg path {
		@apply opacity-0 text-white;
	}

	.svg-container.animate svg path {
		&:first-child {
			animation:
				springIn 600ms cubic-bezier(0.34, 1.56, 0.64, 1) 50ms forwards,
				fadeIn 800ms ease 50ms forwards;
		}

		&:nth-child(2) {
			animation:
				springIn 600ms cubic-bezier(0.34, 1.56, 0.64, 1) 200ms forwards,
				fadeIn 800ms ease 200ms forwards;
		}
		&:nth-child(3) {
			animation:
				springIn 600ms cubic-bezier(0.34, 1.56, 0.64, 1) 350ms forwards,
				fadeIn 800ms ease 350ms forwards;
		}
		&:last-child {
			animation:
				springIn 600ms cubic-bezier(0.34, 1.56, 0.64, 1) 500ms forwards,
				fadeIn 800ms ease 500ms forwards;
		}
	}

	.svg-container.animate {
		transform: scale(0.8);
		animation: scaleIn 850ms cubic-bezier(0.34, 1.56, 0.64, 1) 800ms forwards;
	}

	@keyframes springIn {
		0% {
			transform: translateY(120px);
		}
		60% {
			transform: translateY(-5px);
		}
		80% {
			transform: translateY(2px);
		}
		100% {
			transform: translateY(0);
		}
	}

	#splash-screen-overlay.hide {
		@apply hidden;
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@keyframes scaleIn {
		0% {
			transform: scale(0.8);
		}
		60% {
			transform: scale(1.05);
		}
		100% {
			transform: scale(1);
		}
	}
</style>

<style is:global>
	body.no-scroll {
		overflow: hidden;
	}
</style>

<script>
	function getDuration() {
		const $svgContainer = document.getElementById(
			"svg-container",
		) as HTMLDivElement | null;

		if (!$svgContainer) return 0;

		const styles = getComputedStyle($svgContainer);

		const duration = styles.animationDuration;
		const delay = styles.animationDelay;

		function aMs(valor: string) {
			if (valor.includes("ms")) return parseFloat(valor);
			return parseFloat(valor) * 1000;
		}

		const total = aMs(duration) + aMs(delay);
		return total;
	}

	function onAnimationEnd(event: AnimationEvent) {
		const $svgContainer = document.getElementById(
			"svg-container",
		) as HTMLDivElement | null;

		const $splashScrenOverlay = document.getElementById(
			"splash-screen-overlay",
		);

		if (event.currentTarget !== event.target) return;

		document.body.classList.remove("no-scroll");
		$splashScrenOverlay?.classList.add("hide");

		setTimeout(() => {
			$svgContainer?.classList.remove("animate");
			$svgContainer?.removeEventListener("animationend", onAnimationEnd);
		}, 0);
	}

	window.showSplashScreen = async () => {
		const $svgContainer = document.getElementById(
			"svg-container",
		) as HTMLDivElement | null;
		const $splashScrenOverlay = document.getElementById(
			"splash-screen-overlay",
		) as HTMLDivElement | null;

		document.body.classList.add("no-scroll");
		$splashScrenOverlay?.classList.remove("hide");

		await new Promise((r) => setTimeout(r, 100));

		$svgContainer?.classList.add("animate");

		$svgContainer?.addEventListener("animationend", onAnimationEnd);
		const duration = getDuration();
	
		return duration;
	};

	window.showSplashScreen();
</script>
