---
import { twMerge } from "tailwind-merge";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
	href: string;
	text: string;
	class?: string;
	id: string;
}

const { href, text, class: className, id, ...props } = Astro.props;
---

<a
	id={id}
	href={href}
	class={twMerge(
		"text-text-muted text-shadow-2xs text-shadow-tertiary/30 p-1 peer transition-all text-sm",
		className,
	)}
	{...props}
>
	{text}
</a>

<style>
	@reference "../../styles/global.css";

	a[active] {
		@apply text-primary text-shadow-2xs text-shadow-primary/80;
	}
</style>
