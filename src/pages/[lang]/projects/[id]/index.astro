---
import { PROJECTS } from "@/constants/projects";
import { getLocaleUrl, translations } from "@/i18n/utils";
import Header from "@/components/layout/Header.astro";
import Layout from "@/layouts/Layout.astro";
import {
	IconArrowBadgeLeftFilled,
	IconArrowBadgeRightFilled,
	IconDeviceDesktop,
	IconDeviceMobile,
	IconRocket,
	IconTerminal,
	IconTerminal2,
} from "@tabler/icons-react";
import Footer from "@/components/layout/Footer.astro";
import { twMerge } from "tailwind-merge";

const { id } = Astro.params;
const project = PROJECTS.find((p) => p.id === id);
const { t, lang } = translations(Astro.url);
const link = (path: string) => getLocaleUrl(lang, path);

if (!project) return Astro.redirect(link("projects/404"));

let openProjectText = "Open Live App";
let OpenProjectIcon = IconRocket;

if (project.type === "cli") {
	openProjectText = "Get CLI Tool";
	OpenProjectIcon = IconTerminal;
}
if (project.type === "desktop") {
	openProjectText = "Download Desktop App";
	OpenProjectIcon = IconDeviceDesktop;
}
if (project.type === "mobile") {
	openProjectText = "Dowload Mobile App";
	OpenProjectIcon = IconDeviceMobile;
}
---

<Layout title={t(project.title)} description={t(project.description)}>
	<Header />

	<main class="mt-20">
		<section class="slider w-7/12 aspect-video relative">
			<div class="size-full" id="default-image">
				<img
					class="object-contain size-full"
					src={project.images[0].src}
					alt={t(project.images[0].alt)}
				/>
			</div>
			<div
				class="swiper main-swiper h-full hidden! relative aspect-video"
			>
				<div class="swiper-wrapper">
					{
						project.images.map((image) => {
							return (
								<div class="swiper-slide group">
									<div class="swiper-zoom-container cursor-zoom-in group-[.swiper-slide-zoomed]:cursor-zoom-out">
										<img
											class="object-contain size-full"
											src={image.src}
											alt={t(image.alt)}
										/>
									</div>
								</div>
							);
						})
					}
				</div>

				<div
					class="swiper-buttons absolute bottom-0 right-0 flex flex-row items-center gap-2"
				>
					<div class="swiper-button swiper-button-prev static!">
						<IconArrowBadgeLeftFilled />
					</div>
					<div class="swiper-button swiper-button-next static!">
						<IconArrowBadgeRightFilled />
					</div>
				</div>
			</div>
			<div
				class="swiper-pagination static! mx-auto mt-4 [&_.swiper-pagination-bullet]:bg-text-muted! [&_.swiper-pagination-bullet.swiper-pagination-bullet-active]:bg-primary!"
			>
			</div>
		</section>
		<section class="mt-4 flex flex-row items-center justify-between">
			<section class="">
				<span
					class="flex flex-row items-center gap-1 bg-surface-soft rounded-full px-3 py-1.5 w-fit text-xs text-text-muted mb-3 font-jet-brains uppercase"
				>
					<span
						class={twMerge(
							"block size-2 bg-primary rounded-full",
							!project.active && "bg-red-500",
						)}
					>
					</span>
					<span>Operational_System:</span>
					<span>{project.active ? "Active" : "Inactive"}</span>
				</span>

				<h1 class="text-7xl text-text-primary font-semibold">
					{t(project.title)}
				</h1>

				<p class="text-text-secondary w-7/12 mt-1">
					{t(project.description)}
				</p>

				<div class="flex flex-row gap-2 items-center mt-4">
					{
						project.skills.map((skill) => {
							return (
								<div class="uppercase px-4 py-1 bg-surface-soft text-center rounded text-text-secondary text-xs">
									{skill}
								</div>
							);
						})
					}
				</div>

				<div class="flex flex-row gap-4 uppercase mt-10">
					<a
						href={project.url}
						target="_blank"
						rel="noopener noreferrer"
						class="flex flex-row gap-1 items-center justify-center w-fit bg-surface-soft px-4 py-3 rounded text-text-primary text-xs button-glow cursor-pointer [&_svg]:size-4.5"
					>
						<OpenProjectIcon />
						{openProjectText}
					</a>
					<a
						href={`https://github.com/Cristian-F-M/${project.github}`}
						target="_blank"
						rel="noopener noreferrer"
						class="flex flex-row gap-1 items-center justify-center w-fit bg-surface-soft px-4 py-3 rounded text-text-primary text-xs cursor-pointer [&_svg]:size-4.5"
					>
						<IconTerminal2 />
						View on GitHub
					</a>
				</div>
			</section>
		</section>

		<Footer />
	</main>

	<script>
		const $linkProjects = document.querySelector(
			"#link-projects",
		) as HTMLAnchorElement | null;
		if ($linkProjects) {
			$linkProjects.setAttribute("active", "true");
			window.moveLinkIndicator($linkProjects);
		}
	</script>

	<script>
		import Swiper from "swiper";
		import {
			Navigation,
			Pagination,
			Thumbs,
			Autoplay,
			Zoom,
		} from "swiper/modules";
		import "swiper/swiper-bundle.css";

		const swiper = new Swiper(".main-swiper", {
			modules: [Navigation, Pagination, Thumbs, Zoom],
			loop: true,
			zoom: true,
			pagination: {
				el: ".swiper-pagination",
				type: "bullets",
				clickable: true,
				clickableClass: "cursor-pointer",
			},
			navigation: {
				nextEl: ".swiper-button-next",
				prevEl: ".swiper-button-prev",
				addIcons: false,
			},
			on: {
				init: (swiper) => {
					swiper.el.classList.remove("hidden!");
					document.querySelector("#default-image")?.remove();
				},
			},
		});
	</script>

	<style>
		@reference "../../../../styles/global.css";
		.swiper-button {
			@apply [&_svg]:size-5 bg-surface p-1 rounded size-auto! text-text-primary hover:scale-105 hover:bg-surface-soft cursor-pointer transition-all;
		}
	</style>
</Layout>
